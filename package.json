{
  "name": "@kagawa0710/three-story-controls",
  "version": "2.0.2",
  "description": "A three.js camera toolkit for creating interactive 3d stories (fork of @nytimes/three-story-controls with updated dependencies)",
  "main": "dist/three-story-controls.min.js",
  "module": "dist/three-story-controls.esm.min.js",
  "typings": "./lib/three-story-controls.d.ts",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kagawa0710/three-story-controls.git"
  },
  "homepage": "https://github.com/kagawa0710/three-story-controls",
  "directories": {
    "example": "examples"
  },
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/three-story-controls.esm.min.js",
      "require": "./dist/three-story-controls.min.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "prettier": "prettier --write src/**",
    "build:types": "tsc --declaration --emitDeclarationOnly --declarationMap --declarationDir lib/",
    "api:extract": "api-extractor run --local --verbose",
    "api:extract:production": "api-extractor run",
    "api:generate": "api-documenter markdown --input-folder temp --output-folder docs/",
    "docs": "npm run build:types && npm run api:extract && npm run api:generate",
    "docs:production": "npm run build:types && npm run api:extract:production && npm run api:generate",
    "build:production": "npm run build",
    "prepublishOnly": "npm run prettier && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "peerDependencies": {
    "gsap": ">= 3.6",
    "three": ">= 0.155.0"
  },
  "devDependencies": {
    "@kagawa0710/three-loader-3dtiles": "^2.0.2",
    "@microsoft/api-documenter": "^7.28.2",
    "@microsoft/api-extractor": "^7.55.2",
    "@types/three": "^0.182.0",
    "3d-tiles-renderer": "^0.4.21",
    "gsap": "^3.14.2",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.7.4",
    "terser": "^5.39.0",
    "three": "^0.182.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
